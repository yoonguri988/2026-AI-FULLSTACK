<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.the703.dao.UserMapper"> 
  <select id="findByEmail" resultType="string" parameterType="string">
	select email from users where email=#{email}
  </select>
  <select id="findByNickname" resultType="string" parameterType="string">
	select nickname from users where nickname=#{nickname}
  </select>
  <select id="findByEmailUserInfo" resultType="UserDto" parameterType="string">
	select * from users where email=#{email}
  </select>
  <insert id="insert" parameterType="UserDto">
	insert into users (nickname, bpass, email, mobile, bip)
	values (#{nickname}, #{bpass}, #{email}, #{mobile}, #{bip})
  </insert>
  <insert id="insertAuth"  parameterType="AuthDto">
	insert into  authorities (email, auth) values ( #{email} , #{auth} ) 
  </insert>
  <select     resultMap="authListMap"   id="readAuth"  parameterType="string">
     select    u.email,  u.bpass,  a.auth
     from      users u    left   join authorities a    on u.email   = a.email  
     where     u.email =#{email} 
  </select>
  <resultMap  id="authListMap"          type="AuthUserDto">
       <result  property="email"         column="email"  />
       <result  property="bpass"         column="bpass"  />
       <collection  property="authList"  resultMap="authMap"  />
  </resultMap>
  <resultMap  id="authMap"       type="AuthDto" > 
       <result  property="auth"      column="auth"   />
  </resultMap>  
  
</mapper>
